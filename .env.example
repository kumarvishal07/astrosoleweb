# ==========================================
# AstroSole Environment Configuration Guide
# ==========================================

# ------------------------------------------
# Google Gemini Multimodal AI (Required for foot verification)
# ------------------------------------------
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------
# Razorpay Credentials
# ------------------------------------------
# Public Key ID (used by frontend Razorpay Checkout modal)
VITE_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere

# Server Key ID (used by serverless functions to initiate orders)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere

# Server Key Secret (CRITICAL: Keep private! Never expose to client/VITE)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook Secret (Configured in Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
